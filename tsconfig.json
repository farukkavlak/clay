{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "paths": {
      "@clay/provider-local": ["./providers/local/src/index.ts"],
      "@clay/*": ["./packages/*/src/index.ts"]
    }
  },
  "include": ["packages/*/src", "packages/*/tests", "providers/*/src", "providers/*/tests", "*.ts", "*.mts"]
}
