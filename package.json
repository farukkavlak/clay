{
  "name": "clay",
  "version": "1.0.0",
  "private": true,
  "description": "Infrastructure-as-Code (IaC) Engine",
  "keywords": [
    "iac",
    "infrastructure-as-code",
    "typescript"
  ],
  "license": "ISC",
  "author": "Faruk Kavlak",
  "workspaces": [
    "packages/*",
    "providers/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "format": "prettier --write .",
    "lint": "eslint .",
    "test": "npm run test --workspaces --if-present",
    "type:check": "npm run type:check --workspaces --if-present && tsc --noEmit"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.0",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "@vitest/coverage-v8": "^5.0.1",
    "esbuild": "^0.28.2",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-no-secrets": "^2.1.0",
    "eslint-plugin-promise": "^7.2.1",
    "eslint-plugin-unicorn": "^56.0.0",
    "globals": "^15.14.0",
    "jiti": "^2.6.1",
    "prettier": "^3.4.0",
    "typescript": "^5.7.0",
    "vitest": "^5.0.1"
  }
}
